{
  "name": "book-nest",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm kill-ports && turbo run dev",
    "dev:web": "pnpm kill-ports:web && turbo run dev --filter=@app/web",
    "dev:web:dev": "pnpm kill-ports:web && pnpm --filter @app/shared build && pnpm --filter @app/web dev:dev",
    "dev:web:prod": "pnpm kill-ports:web && pnpm --filter @app/shared build && pnpm --filter @app/web dev:prod",
    "dev:api": "pnpm kill-ports:api && turbo run dev --filter=@app/api",
    "dev:api:dev": "pnpm kill-ports:api && APP_ENV=dev turbo run dev --filter=@app/api",
    "dev:api:prod": "pnpm kill-ports:api && APP_ENV=prod turbo run dev --filter=@app/api",
    "kill-ports": "node scripts/kill-ports.mjs 4000 3000",
    "kill-ports:api": "node scripts/kill-ports.mjs 4000",
    "kill-ports:web": "node scripts/kill-ports.mjs 3000",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose stop db",
    "mail:up": "docker compose up -d mailpit",
    "mail:down": "docker compose stop mailpit",
    "storage:up": "docker compose up -d minio minio-init",
    "storage:down": "docker compose stop minio",
    "dev:up": "docker compose up -d",
    "dev:down": "docker compose down",
    "db:copy:dev": "./scripts/copy-remote-db.sh dev",
    "db:copy:prod": "./scripts/copy-remote-db.sh prod",
    "db:size": "./scripts/db-size.sh",
    "server:ps": "./scripts/server-ps.sh",
    "server:stats": "./scripts/server-stats.sh",
    "server:logs": "./scripts/server-logs.sh",
    "server:health": "./scripts/server-health.sh",
    "server:ssh": "ssh -i ~/.ssh/id_ed25519_hetzner deploy@46.224.83.71",
    "tunnel:dev": "ssh -i ~/.ssh/id_ed25519_hetzner -N -L 5532:127.0.0.1:5432 deploy@46.224.83.71",
    "tunnel:prod": "ssh -i ~/.ssh/id_ed25519_hetzner -N -L 5533:127.0.0.1:5433 deploy@46.224.83.71",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "gen:api": "pnpm --filter @app/api generate:openapi && pnpm --filter @app/web gen:api",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "storybook": "pnpm --filter @app/web storybook",
    "clean:cache": "rm -rf .turbo apps/*/.turbo packages/*/.turbo node_modules/.cache .playwright-mcp && find . -maxdepth 1 -name '*.png' -delete",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "@next/eslint-plugin-next": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "eslint-plugin-boundaries": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-testing-library": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "oxc-parser",
      "oxc-resolver",
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "unrs-resolver",
      "@swc/core"
    ],
    "overrides": {
      "@babel/core": ">=7.29.6 <8",
      "@grpc/grpc-js": ">=1.14.4 <2",
      "@hono/node-server": ">=1.19.13 <2",
      "@opentelemetry/core": ">=2.8.0 <3",
      "body-parser": ">=2.3.0 <3",
      "brace-expansion@1": ">=1.1.16 <2",
      "brace-expansion@5": ">=5.0.8 <6",
      "esbuild": ">=0.28.1 <1",
      "fast-uri": ">=3.1.4 <4",
      "form-data": ">=4.0.6 <5",
      "hono": ">=4.12.27 <5",
      "ip-address": ">=10.1.1 <11",
      "js-yaml": ">=4.3.0 <5",
      "linkify-it": ">=5.0.2 <6",
      "multer": ">=2.2.0 <3",
      "postcss": ">=8.5.10 <9",
      "protobufjs": ">=7.6.5 <8",
      "qs": ">=6.15.2 <7",
      "react-router": ">=7.15.1 <8",
      "sharp": ">=0.35.3 <0.36",
      "uuid": ">=11.1.1 <12",
      "valibot": ">=1.4.2 <2"
    }
  }
}
