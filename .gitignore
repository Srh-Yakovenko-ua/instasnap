# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# turbo prune output (Docker build artifact)
out/

# Generated OpenAPI spec (run `pnpm --filter @app/api generate:openapi`)
openapi.json

# Prisma generated client (run `pnpm --filter @app/api db:generate`)
apps/api/src/generated/

# Env — real values are local/secret; only *.example files are committed
# (exception: apps/web/.env.dev holds only public URLs, committed for zero-setup FE-only dev)
.env
.env.local
.env.dev
!apps/web/.env.dev
.env.prod
.env.*.local
.env.*.readonly
.env.remotely
# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor
.vscode/
.idea/
.DS_Store

# Next.js
apps/web/.next/
apps/web/next-env.d.ts

# Playwright MCP — auto-generated snapshots/console logs from browser sessions
.playwright-mcp/

# Claude Code runtime locks
.claude/*.lock

# Claude Code worktrees — full working copies, node_modules and all
.claude/worktrees/

# Storybook
storybook-static/

# Turborepo cache
.turbo/

# Agent screenshot artifacts in repo root (anchored, src/ and public/ PNGs safe)
/*.png

# Local scratch notes / spec dumps (not part of the codebase)
apps/api/md/

# Agent-generated planning docs — local working material, not part of the codebase.
# Reference docs stay tracked: code-principles.md, typescript-principles.md, architecture.md,
# patterns.md, stack.md, workflow.md, README.md, docs/features/, docs/tools/.
docs/books-to-buy/
docs/delivery-docs/
docs/prompts/
docs/series-order-check/
docs/series-order-check-development-repository/
docs/tasks/

# maintenance flag files are created on the server, never committed
deploy/maintenance/*.on

# local-only setup notes, contains real secrets
book-nest-new-laptop-setup.md
